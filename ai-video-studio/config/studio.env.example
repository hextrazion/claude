# Copy to config/studio.env to change process-level options. Never commit studio.env.
#
# API keys are normally entered on the Integrations page (stored in Windows
# Credential Manager). Environment variables here take precedence if set:
# GROQ_API_KEY=
# FISH_AUDIO_API_KEY=
# TAVILY_API_KEY=

# Where the server listens. Keep 127.0.0.1 unless you have read docs/HOMELAB.md:
# there is no login screen, so binding to your network exposes the studio.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8765

# Optional: put data (database, projects, logs) somewhere else, e.g. a big drive.
# STUDIO_HOME=D:\AI-Video-Studio

# Optional: explicit FFmpeg location (folder containing ffmpeg.exe and ffprobe.exe).
# FFMPEG_PATH=C:\ffmpeg\bin
