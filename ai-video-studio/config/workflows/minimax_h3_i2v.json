{
  "name": "minimax_h3_i2v",
  "label": "MiniMax H3 \u2014 image to video",
  "kind": "video",
  "mode": "i2v",
  "family": "minimax_h3",
  "priority": 3,
  "description": "Built from ComfyUI's official 'MiniMax H3' text-to-video template (FL2VA checkpoint, res_multistep sampler). The studio finds your H3 model files automatically, including GGUF quants. H3's generated audio is not decoded (the narration replaces it), which saves time and memory.",
  "defaults": {
    "width": 480,
    "height": 864,
    "fps": 24,
    "max_frames": 124,
    "frame_multiple": 17,
    "frame_offset": 5
  },
  "requirements": {
    "vram_note": "Community reports: runs on 12 GB with the pruned INT8 model (or a GGUF Q3/Q4 quant via the ComfyUI-GGUF nodes) at ~0.4 MP (480x864), with 32 GB system RAM. Expect several minutes per 5 s clip; the turbo version is about 2.5x faster.",
    "models": [
      {
        "file": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "folder": "ComfyUI/models/diffusion_models",
        "source": "https://huggingface.co/Comfy-Org/MiniMax-H3"
      },
      {
        "file": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "folder": "ComfyUI/models/text_encoders",
        "source": "https://huggingface.co/Comfy-Org/MiniMax-H3"
      },
      {
        "file": "minimax_h3_video_vae_int8_convrot.safetensors",
        "folder": "ComfyUI/models/vae",
        "source": "https://huggingface.co/Comfy-Org/MiniMax-H3"
      }
    ],
    "license": "MiniMax H3 Community License: users in the US, UK, EU and South Korea must apply to MiniMax before use."
  },
  "bindings": {
    "prompt": [
      {
        "node": "4",
        "input": "prompt"
      }
    ],
    "width": [
      {
        "node": "4",
        "input": "width"
      }
    ],
    "height": [
      {
        "node": "4",
        "input": "height"
      }
    ],
    "frames": [
      {
        "node": "4",
        "input": "length"
      }
    ],
    "fps": [
      {
        "node": "11",
        "input": "fps"
      }
    ],
    "seed": [
      {
        "node": "5",
        "input": "noise_seed"
      }
    ],
    "filename_prefix": [
      {
        "node": "12",
        "input": "filename_prefix"
      }
    ],
    "image": [
      {
        "node": "14",
        "input": "image"
      }
    ]
  },
  "model_slots": [
    {
      "node": "1",
      "input": "unet_name",
      "require": [
        "h3"
      ],
      "avoid": [
        "r2v",
        "ref2va",
        "lora",
        "turbo",
        "vae"
      ],
      "prefer": [
        "fl2va",
        "fl2v",
        "int8",
        "q4",
        "q5"
      ],
      "gguf_class": "UnetLoaderGGUF",
      "label": "H3 video model"
    },
    {
      "node": "2",
      "input": "clip_name",
      "require": [],
      "any_of": [
        "qwen3vl",
        "qwen",
        "h3",
        "minimax"
      ],
      "avoid": [
        "vae",
        "fl2va",
        "lora"
      ],
      "prefer": [
        "h3",
        "minimax",
        "qwen3vl",
        "int8",
        "fp8"
      ],
      "gguf_class": "CLIPLoaderGGUF",
      "label": "H3 text encoder"
    },
    {
      "node": "3",
      "input": "vae_name",
      "require": [
        "h3"
      ],
      "any_of": [
        "video"
      ],
      "avoid": [
        "audio"
      ],
      "prefer": [
        "video",
        "int8"
      ],
      "label": "H3 video VAE"
    }
  ],
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "title": "Load Diffusion Model (H3 FL2VA)"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "_meta": {
        "title": "Load Text Encoder"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors"
      },
      "_meta": {
        "title": "Load Video VAE"
      }
    },
    "4": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "prompt": "",
        "width": 480,
        "height": 864,
        "length": 124,
        "first_frame": [
          "14",
          0
        ]
      },
      "_meta": {
        "title": "MiniMax H3 Image to Video"
      }
    },
    "5": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 0
      },
      "_meta": {
        "title": "RandomNoise"
      }
    },
    "6": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "res_multistep"
      },
      "_meta": {
        "title": "KSamplerSelect"
      }
    },
    "7": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "scheduler": "simple",
        "steps": 20,
        "denoise": 1.0
      },
      "_meta": {
        "title": "BasicScheduler"
      }
    },
    "8": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "conditioning": [
          "4",
          0
        ]
      },
      "_meta": {
        "title": "BasicGuider"
      }
    },
    "9": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "5",
          0
        ],
        "guider": [
          "8",
          0
        ],
        "sampler": [
          "6",
          0
        ],
        "sigmas": [
          "7",
          0
        ],
        "latent_image": [
          "4",
          1
        ]
      },
      "_meta": {
        "title": "SamplerCustomAdvanced"
      }
    },
    "10": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "9",
          0
        ],
        "vae": [
          "3",
          0
        ]
      },
      "_meta": {
        "title": "VAE Decode (video)"
      }
    },
    "11": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "10",
          0
        ],
        "fps": 24
      },
      "_meta": {
        "title": "Create Video"
      }
    },
    "12": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "11",
          0
        ],
        "filename_prefix": "ai_video_studio/clip",
        "format": "auto",
        "format.codec": "auto"
      },
      "_meta": {
        "title": "Save Video"
      }
    },
    "14": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "example.png"
      },
      "_meta": {
        "title": "First frame"
      }
    }
  }
}